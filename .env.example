# Скопируйте этот файл в .env и впишите ключ. Файл .env в репозиторий не попадает.

# Ключ Gemini API: https://aistudio.google.com/ → Get API key. Бесплатного тарифа достаточно.
GEMINI_API_KEY=

# Модель. Пусто — модель по умолчанию из README.
REQCHECK_MODEL=

# Резервный провайдер (необязательно): любой OpenAI-совместимый endpoint.
# Включается, только если заданы все три переменные. Используется при квоте/5xx/сети у Gemini.
# Базовый URL без /chat/completions, например https://host/v1
REQCHECK_FALLBACK_BASE_URL=
REQCHECK_FALLBACK_API_KEY=
REQCHECK_FALLBACK_MODEL=

# Каталог кэша ответов модели. Пусто — .reqcheck_cache/ в текущем каталоге.
REQCHECK_CACHE_DIR=
# 1 — отключить кэш (финальный прогон делаем без кэша).
REQCHECK_NO_CACHE=

# REQCHECK_MODEL — список через запятую в порядке предпочтения; на 429/503/504 берётся следующая
# модель (суточная квота исчерпана — модель до конца прогона не пробуется), затем резервный провайдер.
# Пример: REQCHECK_MODEL=gemini-3.1-flash-lite,gemini-3.5-flash-lite
